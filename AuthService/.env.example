# Copy to .env and fill in for your setup. Never commit the real .env.

# Uses a dedicated "auth" schema inside the existing swiggy_clone database,
# fully isolated from the restaurants/items tables the FastAPI backend owns.
DATABASE_URL="postgresql://swiggy_user:12345@localhost:5432/swiggy_clone?schema=auth"

# Shared secret used to sign/verify JWTs. Must match JWT_SECRET in
# Backend/.env so FastAPI can verify tokens this service issues.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-value

# How long an access token stays valid.
JWT_EXPIRES_IN=1h

PORT=4000

# Comma-separated list of allowed frontend origins (mirrors Backend's CORS_ORIGINS).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email OTP (passwordless login), sent via Mailjet's free transactional
# email API (https://app.mailjet.com — no card required). Get both keys
# under Account Settings > API Key Management, and MAILJET_SENDER_EMAIL
# must be an address you've verified as a sender in that account.
# Leave MAILJET_API_KEY/MAILJET_API_SECRET unset to develop against a
# console-logged code instead of sending real email — see src/lib/email.js.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_SENDER_EMAIL=
MAILJET_SENDER_NAME=Swiggy Clone
