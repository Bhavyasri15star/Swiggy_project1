# Copy to .env at the repo root. docker-compose.yml reads this automatically.
# Not needed for a purely local `docker compose up` — every value below has
# a working local-only default baked into docker-compose.yml itself.

# Shared secret AuthService signs JWTs with and FastAPI verifies them with.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-value

# Set these to your actual public hostnames once this is deployed somewhere
# reachable outside your machine (a cloud host, a tunnel, etc.) — they're
# baked into the frontend at build time and used for CORS on the other two.
# Leave unset for local-only `docker compose up` (defaults to localhost).
PUBLIC_API_URL=https://api.example.com
PUBLIC_AUTH_URL=https://auth.example.com
PUBLIC_FRONTEND_URL=https://app.example.com
