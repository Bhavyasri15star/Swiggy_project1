# Copy to .env (or .env.local) and set for your setup.
# For LAN hosting, use the backend host's LAN IP instead of localhost, e.g.:
# REACT_APP_API_URL=http://192.168.30.16:8000
REACT_APP_API_URL=http://127.0.0.1:8000

# Address-picker map (Address.jsx) -- get a free token at mapbox.com.
# Leave unset and the map just shows an error tile; it's decorative only.
REACT_APP_MAPBOX_TOKEN=
